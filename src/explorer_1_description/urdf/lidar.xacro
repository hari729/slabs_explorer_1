<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.038"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.038"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.015"/>
    </collision>
  </link>

  <joint name="top_cover_laser_joint" type="fixed">
    <parent link="top_cover"/>
    <child link="laser_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0.038"/>
  </joint>
</robot>

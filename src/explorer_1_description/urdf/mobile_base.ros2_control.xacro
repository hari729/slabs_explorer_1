<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     mobile_base.ros2_control.xacro — ros2_control block for ESP32 hardware interface

     Parameters you MUST calibrate on the real robot:
       - ticks_per_revolution  (rotate wheel 10 revs, count ticks / 10)
       - left/right ff_k, ff_d0, min_duty, kp, ki (use the onboard tuning mode)

     Wheel geometry (wheel_radius, wheel_separation) is configured in the
     diff_drive_controller YAML, not here.
     ============================================================================= --><robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_esp32_hardware" default="true"/>
  <xacro:if value="$(arg use_esp32_hardware)">
  <ros2_control name="esp32_diff_drive_ros2_control" type="system">
    <hardware>
      <plugin>esp32_hardware/Esp32HardwareInterface</plugin>
      <param name="serial_port">/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0</param>
      <param name="baud_rate">115200</param>
      <param name="ticks_per_revolution">1399.2</param>
      <param name="max_abs_rpm">112.5</param>
      <param name="left_ff_k_fwd">7.048</param>
      <param name="left_ff_d0_fwd">141.3</param>
      <param name="left_min_duty_fwd">270.0</param>
      <param name="left_ff_k_rev">7.412</param>
      <param name="left_ff_d0_rev">60.0</param>
      <param name="left_min_duty_rev">240.0</param>
      <param name="left_kp">1.972</param>
      <param name="left_ki">19.718</param>
      <param name="right_ff_k_fwd">7.019</param>
      <param name="right_ff_d0_fwd">142.5</param>
      <param name="right_min_duty_fwd">330.0</param>
      <param name="right_ff_k_rev">7.454</param>
      <param name="right_ff_d0_rev">69.4</param>
      <param name="right_min_duty_rev">240.0</param>
      <param name="right_kp">1.974</param>
      <param name="right_ki">19.736</param>
    </hardware>
    <joint name="base_right_1_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <joint name="base_right_2_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <joint name="base_left_1_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>
    <joint name="base_left_2_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"></state_interface>
      <state_interface name="velocity"></state_interface>
    </joint>

    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>
  </xacro:if>
</robot>
